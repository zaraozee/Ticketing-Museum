APP_NAME="Jejak"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Production: pgsql, Local: pgsql or sqlite)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=museum_ticketing
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie sesi (SYSTEM_DESIGN §16). Di produksi HTTPS wajib:
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax
# `null` berarti Laravel memakai nilai aman bawaan (HttpOnly aktif).
SESSION_SECURE_COOKIE=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=jejak_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@jejak.id"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Google Maps Embed API (opsional — tanpa key, halaman museum hanya menampilkan tautan arah)
GOOGLE_MAPS_API_KEY=

# Media museum (disk penyimpanan foto; produksi dapat diarahkan ke S3)
MUSEUM_MEDIA_DISK=public

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# Ticket Security
TICKET_SIGNING_KEYS='{"MT1":"base64-random-key-at-least-32-bytes"}'

# Rate limiting (SYSTEM_DESIGN §16; lihat config/security.php)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_BOOKING=20
RATE_LIMIT_SCAN=60
RATE_LIMIT_SCAN_MANUAL=10
RATE_LIMIT_WEBHOOK=120

# Ambang alarm operasional (Fase 9; dipakai `php artisan ops:health`)
MONITORING_FAILED_JOBS_THRESHOLD=5
MONITORING_QUEUE_AGE_MINUTES=10
MONITORING_STUCK_PAYMENT_MINUTES=30
MONITORING_WEBHOOK_LAG_MINUTES=10

VITE_APP_NAME="${APP_NAME}"
