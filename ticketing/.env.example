APP_NAME="MusenTix"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (Production: pgsql, Local: pgsql or sqlite)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=museum_ticketing
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie sesi (SYSTEM_DESIGN §16). Di produksi HTTPS wajib:
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax
# `null` berarti Laravel memakai nilai aman bawaan (HttpOnly aktif).
SESSION_SECURE_COOKIE=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=musentix_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit untuk pengembangan (SMTP 1025, web UI http://localhost:8025).
# Jalankan: mailpit --smtp 127.0.0.1:1025 --listen 127.0.0.1:8025
# Di produksi ganti dengan SMTP/API transaksional nyata.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@musentix.test"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Google Maps Embed API (opsional — tanpa key, halaman museum hanya menampilkan tautan arah)
GOOGLE_MAPS_API_KEY=

# Media museum (disk penyimpanan foto; produksi dapat diarahkan ke S3)
MUSEUM_MEDIA_DISK=public

# Midtrans Payment Gateway
#
# Server Key mengotorisasi panggilan API (Snap, status) dan dibuat di
# Settings > Access Keys > Generate server key. Kunci ini hanya ditampilkan
# sekali, jadi simpan saat dibuat.
MIDTRANS_SERVER_KEY=
# Signature Secret Key memverifikasi `signature_key` pada notifikasi. Sejak
# 28 Oktober 2026 kunci ini terpisah dari Server Key. Biarkan kosong bila akun
# Anda belum memisahkannya — nilainya akan jatuh kembali ke Server Key.
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Biarkan kosong: nilai bawaan mengikuti MIDTRANS_IS_PRODUCTION. Mengisinya
# dengan host sandbox lalu menyalakan mode produksi adalah kesalahan yang
# membuat pembayaran produksi gagal tanpa pesan jelas.
MIDTRANS_SNAP_URL=

# Ticket Security
TICKET_SIGNING_KEYS='{"MT1":"base64-random-key-at-least-32-bytes"}'

# Rate limiting (SYSTEM_DESIGN §16; lihat config/security.php)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=10
RATE_LIMIT_PASSWORD=5
RATE_LIMIT_BOOKING=20
RATE_LIMIT_SCAN=60
RATE_LIMIT_SCAN_MANUAL=10
RATE_LIMIT_WEBHOOK=120

# Ambang alarm operasional (Fase 9; dipakai `php artisan ops:health`)
# Monitoring (Fase 9, NFR-13). Isi MONITORING_PING_URL dengan ping URL
# Healthchecks.io agar `ops:health` sendiri yang mengirim kabar ke monitor.
MONITORING_FAILED_JOBS_THRESHOLD=5
MONITORING_QUEUE_AGE_MINUTES=10
MONITORING_STUCK_PAYMENT_MINUTES=30
MONITORING_WEBHOOK_LAG_MINUTES=10
MONITORING_PING_URL=

VITE_APP_NAME="${APP_NAME}"
